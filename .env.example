# Local-only example file for Nextcloud Docker deployment.
# Copy this file to .env and fill in real values locally.
# Do not commit .env or any real credentials to Git.

NEXTCLOUD_SSH_HOST=
NEXTCLOUD_SSH_USER=
NEXTCLOUD_SSH_PORT=22
NEXTCLOUD_APP_PATH=/var/www/html/apps/timesheets
NEXTCLOUD_WEBROOT=/var/www/html
NEXTCLOUD_DOCKER_SERVICE=

# Optional: if you use a dev/test deployment target
NEXTCLOUD_TEST_URL=https://your-nextcloud-instance.example
