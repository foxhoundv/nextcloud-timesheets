# Credential-free template for local Nextcloud testing and SSH access.
# Copy this file to .env and fill in real values locally.
# Do not commit .env or any real credentials to Git.
# This file is not loaded automatically by the app.
# When using dotenv tooling, quote values containing spaces or special characters.

# Nextcloud testing instance (use a dedicated test account and app password)
NEXTCLOUD_TEST_URL=
NEXTCLOUD_TEST_USERNAME=
NEXTCLOUD_TEST_APP_PASSWORD=

# SSH access to the testing server
NEXTCLOUD_SSH_HOST=
NEXTCLOUD_SSH_USER=
NEXTCLOUD_SSH_PORT=22
# Prefer a private key; enter its local path, not its contents.
NEXTCLOUD_SSH_PRIVATE_KEY_PATH=
# Optional: only fill this in if using password-based SSH authentication.
NEXTCLOUD_SSH_PASSWORD=

# Server paths (adjust to match your installation)
NEXTCLOUD_APP_PATH=/var/www/html/apps/timesheets
NEXTCLOUD_WEBROOT=/var/www/html
# Optional: Docker Compose service name, if applicable
NEXTCLOUD_DOCKER_SERVICE=
